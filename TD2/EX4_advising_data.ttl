@prefix s2a: <http://example.org/s2a/> .
@prefix uni: <http://example.org/university/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

uni:DSA201  rdf:type s2a:Course ;
            s2a:hasTitle "Data Structures and Algorithms" .
uni:WEB301  rdf:type s2a:Course ;
            s2a:hasTitle "Web Technologies" .
uni:SWKM701 rdf:type s2a:Course ;
            s2a:hasTitle "Semantic Web and Knowledge Management" ;
            s2a:hasPrerequisite uni:DSA201 ;
            s2a:hasPrerequisite uni:WEB301 .

uni:Alice rdf:type s2a:Student ;
          s2a:hasPassedCourse uni:DSA201 .
# No triple says Alice passed WEB301.
